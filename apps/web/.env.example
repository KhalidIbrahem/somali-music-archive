# apps/web/.env.example
# Copy to `.env.local`. Only NEXT_PUBLIC_* vars reach the browser bundle — never
# put a secret in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# The AI service (FastAPI, apps/ai-service). The transcribe and generate pages
# call it directly; it keeps the generation service's token on its own side.
NEXT_PUBLIC_AI_URL=http://localhost:8000

# Feature flags: 'true' or 'false' (lib/flags.ts holds the defaults).
# Courses and Learn are hidden for now; set to true to bring them back.
NEXT_PUBLIC_ENABLE_COURSES=false
NEXT_PUBLIC_ENABLE_LEARN=false
# The composition studio (DAW) at /daw and its "Studio" nav item; hidden, not part of the research demo.
NEXT_PUBLIC_ENABLE_DAW=false
# Generate page lists only the adapters the local generation service serves;
# 'false' restores the earlier provider tiers through the Node API.
NEXT_PUBLIC_GENERATE_SERVED_ONLY=true

# Google sign-in (optional). The OAuth *web* client ID — the same value as the
# API's GOOGLE_CLIENT_ID. Empty/unset → the "Continue with Google" button is
# not rendered at all. Public by design (it is the OAuth audience).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Where the AI service runs: local (this machine, at NEXT_PUBLIC_AI_URL),
# remote (another machine, same calls) or off (no live service: the Transcribe
# and Generate pages show examples rendered ahead of time). Unset: local when
# NEXT_PUBLIC_AI_URL is given, otherwise off. The public site runs with off.
NEXT_PUBLIC_AI_SERVICE_MODE=local

# The page gate. 'true' is the invite-only configuration: every page except the
# landing page and the auth doors needs a session, and the header shows Sign in
# and the account menu. 'false' (default, the public site): every page opens
# without an account; Sign in, Create account, the account menu and the
# member-only pages (/login, /register, /account, /teach) are hidden, and
# Listen and Library list only cleared demo material.
NEXT_PUBLIC_REQUIRE_AUTH=false
