# apps/web/.env.example
# Copy to `.env.local`. Only NEXT_PUBLIC_* vars reach the browser bundle — never
# put a secret in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Google sign-in (optional). The OAuth *web* client ID — the same value as the
# API's GOOGLE_CLIENT_ID. Empty/unset → the "Continue with Google" button is
# not rendered at all. Public by design (it is the OAuth audience).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
