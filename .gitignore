# ─────────────────────────────────────────────────────────────────────────────
# Somali Music AI Preservation Platform — root .gitignore
# Covers: Node, Python, Expo/React Native, macOS.
# WHY committed carefully: this is a permanent archive project. A single leaked
# .env would expose R2 storage keys, Stripe secrets, and database URIs for
# irreplaceable cultural material. When in doubt, ignore it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets & environment ────────────────────────────────────────────────────
# Never commit real secrets. Only *.env.example (placeholders) are tracked.
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
.doppler
secrets/

# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
.eslintcache
*.tsbuildinfo
dist/
build/
coverage/
.turbo/

# ── Next.js (apps/web) ───────────────────────────────────────────────────────
.next/
out/
.vercel/

# ── Expo / React Native (apps/mobile) ────────────────────────────────────────
.expo/
.expo-shared/
web-build/
*.jks
*.p8
*.p12
*.mobileprovision
*.orig.*
ios/
android/
# EAS local build artifacts
*.ipa
*.apk
*.aab

# ── Python (apps/ai-service) ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
.ipynb_checkpoints/
# Downloaded ML model weights — huge, never committed (fetched at deploy time)
models/weights/
*.ckpt
*.pt
*.safetensors
wandb/

# ── Docker / local data volumes ──────────────────────────────────────────────
.docker-data/
# Local dev seed store (apps/api/.data/dev-store.json) — machine-local, never committed.
.data/

# ── Editors & tooling ────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
*.swp
*.swo

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon?

# ── Cloud-sync conflict copies (iCloud/Dropbox on ~/Desktop) ─────────────────
# e.g. "register 2.tsx", "Input 2.tsx" — auto-created duplicates, never real source.
* [0-9].*

# ── Stray tooling artifacts ──────────────────────────────────────────────────
# Expo/TS periodically writes a ROOT tsconfig.json extending expo/tsconfig.base;
# the real config is tsconfig.base.json + per-workspace tsconfigs. Ignore only the
# root one (leading slash) — workspace tsconfig.json files stay tracked.
/tsconfig.json

# ── Logs & temp ──────────────────────────────────────────────────────────────
logs/
*.log
tmp/
temp/

# ── Harvard corpus pipeline outputs (regenerable; audio never committed) ─────
# Curated artifacts stay tracked: data/harvard_inventory.csv, data/DATASET_CARD.md
data/0*_*/
data/transcripts/
data/pitch_data/
data/embeddings/
data/dataset/
data/reports/
data/progress.json
data/harvard_audio/
data/analysis/validation_full/
.vercel
.env*

# ── Corpus-training artifacts (Jul 2026): regenerable or too large for git ───
# Tracked: data/manifest.csv, captions.jsonl, splits.json, eval_pcs/, transcriptions/
data/clips/
data/tokens/
data/eval_gen/
data/notation_jobs/
# Same runtime job artifacts, written by the ai-service itself (the root
# data/notation_jobs/ pattern above does not reach this nested path).
apps/ai-service/data/notation_jobs/
data/phase*.log
runs/*/ckpt_step_*/
runs/*/samples/
runs/*/samples_smoke/
runs/smoke/

# Corpus MP3s staged for the web listening room (~120MB, license_status=unknown):
# audio belongs in R2/deploy uploads, never in git history.
apps/web/public/audio/
# Same rule for the research-demo stems (corpus-derived, ~29MB).
apps/web/public/demos/audio/
.vercel-token

# ── Local AI tooling config — never tracked (history scrubbed 2026-08-06) ───
.claude/
CLAUDE.md
.mcp.json
