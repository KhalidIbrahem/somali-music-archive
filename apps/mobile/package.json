{
  "name": "@sma/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Somali Music AI Preservation Platform — React Native (Expo) mobile app. The primary product (ARCHITECTURE.md §6). Mobile-first, offline-capable, dark-mode primary.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "//lint": "ESLint (eslint-config-expo) is wired in Phase 1; until then `lint` runs the type gate so `turbo run lint` is always green.",
    "lint": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "clean": "rimraf .turbo .expo node_modules"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.4.0",
    "@sma/constants": "*",
    "@sma/types": "*",
    "@sma/validators": "*",
    "@tanstack/react-query": "^5.49.2",
    "axios": "^1.7.2",
    "expo": "~57.0.4",
    "expo-audio": "~57.0.0",
    "expo-constants": "^57.0.3",
    "expo-dev-client": "^57.0.5",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-local-authentication": "~57.0.0",
    "expo-notifications": "^57.0.3",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "^57.0.2",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "react": "19.2.3",
    "react-hook-form": "^7.55.0",
    "react-native": "^0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
