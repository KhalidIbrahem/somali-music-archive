# apps/api/.env.example
# Copy to `.env` and fill in with REAL values. NEVER put real secrets in THIS file —
# it is committed. Real secrets live only in `.env` (git-ignored, see root .gitignore).
# In production these come from Doppler / AWS Secrets Manager, not a file.
# Every variable here is validated by src/config/env.ts at startup — a missing or
# malformed value fails the boot loudly instead of causing a mystery 500 later.
# `npm run dev` / `npm start` load `.env` automatically (src/config/bootstrapEnv.ts).

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
# Comma-separated list of origins allowed by CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate strong secrets, e.g. `openssl rand -hex 32`. Min 32 chars each, distinct.
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_32+
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ── Persistence ───────────────────────────────────────────────────────────────
# memory (default) = in-memory repositories, zero infrastructure. database = the
# Prisma/Postgres + Mongoose/Mongo repositories (see prisma/README.md to enable).
PERSISTENCE=memory

# ── Databases (only required when PERSISTENCE=database) ───────────────────────
MONGODB_URI=mongodb://localhost:27017/somali-archive
POSTGRES_URL=postgresql://sma:sma@localhost:5432/somali_archive
REDIS_URL=redis://localhost:6379

# ── Cloudflare R2 (S3-compatible) ─────────────────────────────────────────────
# Audio NEVER flows through this API — clients upload directly to R2 via presigned
# URLs generated with these credentials (CLAUDE.md hard rule, ARCHITECTURE.md §8).
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_NAME=somali-audio-archive
R2_PUBLIC_DOMAIN=https://cdn.somalimusicarchive.com

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PREMIUM_PRICE_ID=price_CHANGE_ME
STRIPE_INSTITUTIONAL_PRICE_ID=price_CHANGE_ME

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=noreply@somalimusicarchive.com

# ── AI service ────────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=CHANGE_ME_INTERNAL_KEY

# ── AI music generation (Suno / Lyria proxy) ─────────────────────────────────
# Every var below is optional: LEAVE THE KEYS EMPTY and dev/test serve a built-in
# fake provider so the whole generate→poll→play flow works with zero keys.
# Production without a key answers 503 GENERATION_PROVIDER_UNAVAILABLE instead.
# How to obtain each key: see SETUP.md at the repo root.
# Suno has NO official public API — this key comes from the api.sunoapi.org
# reseller (ToS/commercial-rights caveats in SETUP.md).
SUNO_API_KEY=
# Reseller base URL (override to switch resellers or a future official API).
SUNO_API_BASE_URL=https://api.sunoapi.org
# Suno model version the reseller accepts: V4, V4_5, V4_5PLUS, V5, …
SUNO_MODEL=V5
# Google Gemini API key (https://aistudio.google.com) — Lyria rides the Gemini API.
GEMINI_API_KEY=
# lyria-3-clip-preview (~30s MP3) or lyria-3-pro-preview (~2min; needs the R2 path).
LYRIA_MODEL=lyria-3-clip-preview
# Hard cap on one provider HTTP call (Lyria generates inside a single call).
GENERATION_PROVIDER_TIMEOUT_MS=90000
# How long POST /generate waits before answering 201 queued (clients poll anyway).
GENERATION_SUBMIT_BUDGET_MS=8000
# Generation jobs are ephemeral; evicted after this many seconds.
GENERATION_JOB_TTL_SEC=86400
# Suno's required webhook target; empty derives {API_URL}/api/v1/generate/callback.
GENERATION_CALLBACK_URL=

# ── Search (Elasticsearch) ────────────────────────────────────────────────────
# Full-text search is opt-in (heavy): `docker compose --profile search up -d`.
# Leave URL empty to use the built-in in-memory index — the API still boots and
# /search works. Point it at the ES node (default http://localhost:9200) to use ES.
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX=recordings

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
