# apps/ai-service/.env.example
# Copy to `.env`. Loaded and validated by config.py (pydantic-settings).

# Server
AI_ENV=development
AI_PORT=8000

# Shared secret the Node API uses to authenticate to this internal service.
# Must match AI_SERVICE_API_KEY in apps/api/.env.
AI_SERVICE_API_KEY=CHANGE_ME_INTERNAL_KEY

# Where to POST completed analysis results back to (the Node API).
CALLBACK_API_URL=http://localhost:3001/api/v1

# Model configuration.
WHISPER_MODEL=large-v3
# Inference device: empty = auto (MPS on Apple Silicon -> CUDA -> CPU).
WHISPER_DEVICE=
MERT_MODEL=m-a-p/MERT-v1-95M
# CREPE confidence floor for keeping a pitch frame (ARCHITECTURE.md §10).
PITCH_CONFIDENCE_THRESHOLD=0.80

# Job queue. USE_CELERY=false runs jobs in-process (no Redis needed, dev only).
USE_CELERY=false
CELERY_BROKER_URL=redis://localhost:6379/0

# Error tracking (worker failures).
SENTRY_DSN=

# Optional experiment tracking.
WANDB_API_KEY=
