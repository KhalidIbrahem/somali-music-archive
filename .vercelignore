# Upload allowlist for Vercel source deploys (web + api projects build remotely
# from this repo). NOTE: when .vercelignore exists it takes over from .gitignore
# for the upload, so secrets and heavy dirs must be re-excluded here.

# Secrets — never upload (mirrors .gitignore)
.env
.env.*
!.env.example

# Held recordings staged locally for the invite-only listening room and the
# research-demo stems. Never part of a deploy: the July 2026 CLI upload had
# shipped them because this file, not .gitignore, decides what is uploaded.
apps/web/public/audio
apps/web/public/demos/audio

# Dependencies / VCS / caches
node_modules
.git
.turbo
.vercel
.DS_Store
*.log

# Build outputs (regenerated by the remote build)
.next
dist
apps/api/api

# Research data and run artifacts: hundreds of GB, including held source audio.
# Never part of a deploy (a CLI deploy from the repo root would upload them).
data
runs
logs
HANDOVER.md
REPORT.md

# Not needed by the web or api builds
apps/mobile/ios
apps/mobile/android
apps/mobile/.expo
apps/ai-service
docs
