# apps/mobile/.env.example
# Copy to `.env` and fill in. Only EXPO_PUBLIC_* vars are exposed to the client
# bundle — NEVER put a secret here (anything shipped to a phone is public).
# Real secrets (signing keys, service tokens) live in EAS secrets / Doppler.

# Base URL of the backend API (includes the /api/v1 version prefix).
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1

# Client-side observability (safe-to-publish public keys only).
EXPO_PUBLIC_SENTRY_DSN=CHANGE_ME
EXPO_PUBLIC_POSTHOG_KEY=CHANGE_ME
