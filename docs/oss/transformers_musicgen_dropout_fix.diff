diff --git a/tests/models/musicgen/test_modeling_musicgen.py b/tests/models/musicgen/test_modeling_musicgen.py
--- a/tests/models/musicgen/test_modeling_musicgen.py
+++ b/tests/models/musicgen/test_modeling_musicgen.py
@@ -<inside class MusicgenDecoderTest(ModelTesterMixin, GenerationTesterMixin, unittest.TestCase)> @@
+    def test_train_mode_matches_eval_mode_by_default(self):
+        # The released MusicGen checkpoints were trained without dropout. A default config must not turn any on,
+        # or fine-tuning optimises a forward path that `generate` never uses (train-mode loss on the model's own
+        # tokens went from 4.8 to 9.7 nats with the old default of 0.1).
+        config, inputs_dict = self.model_tester.prepare_config_and_inputs_for_common()
+        self.assertEqual(config.dropout, 0.0)
+        model = MusicgenForCausalLM(config).to(torch_device).eval()
+        torch.manual_seed(0)
+        with torch.no_grad():
+            eval_logits = model(**inputs_dict).logits
+        model.train()
+        torch.manual_seed(0)
+        with torch.no_grad():
+            train_logits = model(**inputs_dict).logits
+        torch.testing.assert_close(eval_logits, train_logits)
+
+    def test_train_mode_warns_once_when_dropout_is_on(self):
+        config, _ = self.model_tester.prepare_config_and_inputs_for_common()
+        config.dropout = 0.1
+        model = MusicgenForCausalLM(config).to(torch_device)
+        logger = logging.get_logger("transformers.models.musicgen.modeling_musicgen")
+        with CaptureLogger(logger) as cl:
+            model.train()
+            model.eval()
+            model.train()
+        self.assertEqual(cl.out.count("entered train mode with non-zero decoder dropout"), 1)
+        self.assertIn("'dropout': 0.1", cl.out)
+
+    def test_train_mode_is_silent_when_dropout_is_off(self):
+        config, _ = self.model_tester.prepare_config_and_inputs_for_common()
+        model = MusicgenForCausalLM(config).to(torch_device)
+        logger = logging.get_logger("transformers.models.musicgen.modeling_musicgen")
+        with CaptureLogger(logger) as cl:
+            model.train()
+        self.assertEqual(cl.out, "")
+
