{
  "name": "@sma/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Somali Music AI Preservation Platform — React Native (Expo) mobile app. The primary product (ARCHITECTURE.md §6). Mobile-first, offline-capable, dark-mode primary.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "//lint": "ESLint (eslint-config-expo) is wired in Phase 1; until then `lint` runs the type gate so `turbo run lint` is always green.",
    "lint": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "clean": "rimraf .turbo .expo node_modules"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "dependencies": {
    "@sma/constants": "*",
    "@sma/types": "*",
    "@sma/validators": "*",
    "@expo/vector-icons": "^14.0.2",
    "@expo-google-fonts/nunito": "^0.2.3",
    "@expo-google-fonts/playfair-display": "^0.2.3",
    "@hookform/resolvers": "^3.6.0",
    "@tanstack/react-query": "^5.49.2",
    "axios": "^1.7.2",
    "expo": "~51.0.0",
    "expo-av": "~14.0.6",
    "expo-constants": "~16.0.2",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.7",
    "expo-linking": "~6.3.1",
    "expo-local-authentication": "~14.0.1",
    "expo-notifications": "~0.28.9",
    "expo-router": "~3.5.16",
    "expo-secure-store": "~13.0.1",
    "expo-splash-screen": "~0.27.5",
    "expo-sqlite": "~14.0.4",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-hook-form": "^7.52.0",
    "react-native": "0.74.3",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.5.1",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.79",
    "@types/react-test-renderer": "^18.3.0",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.3",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.5.3"
  }
}
