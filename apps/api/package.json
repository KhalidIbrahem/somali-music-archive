{
  "name": "@sma/api",
  "version": "0.1.0",
  "private": true,
  "description": "Somali Music AI Preservation Platform — Node.js + Express backend API (ARCHITECTURE.md §8). Modular monolith: auth, recordings, lessons, subscriptions, research.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "build:vercel": "prisma generate && tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/scripts/seed.ts",
    "promote": "tsx src/scripts/promote.ts",
    "ingest:harvard": "tsx src/scripts/ingest-harvard.ts",
    "migrate:devstore": "tsx src/scripts/migrate-devstore.ts",
    "rotate:seed-passwords": "tsx src/scripts/rotate-seed-passwords.ts",
    "doctor": "tsx src/scripts/doctor.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "clean": "rimraf .turbo dist node_modules coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.606.0",
    "@aws-sdk/s3-request-presigner": "^3.606.0",
    "@prisma/client": "^5.22.0",
    "@sma/constants": "*",
    "@sma/types": "*",
    "@sma/validators": "*",
    "@vercel/functions": "^3.7.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^5.0.0",
    "redis": "^6.1.0",
    "stripe": "^22.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/supertest": "^7.2.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "mongodb-memory-server": "^11.2.0",
    "prisma": "^5.16.1",
    "supertest": "^7.0.0",
    "tsup": "^8.1.0",
    "tsx": "^4.16.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
