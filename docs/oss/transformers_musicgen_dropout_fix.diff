diff --git a/src/transformers/models/musicgen/modeling_musicgen.py b/src/transformers/models/musicgen/modeling_musicgen.py
--- a/src/transformers/models/musicgen/modeling_musicgen.py
+++ b/src/transformers/models/musicgen/modeling_musicgen.py
@@ -423,6 +423,30 @@ class MusicgenPreTrainedModel(PreTrainedModel):
     _supports_sdpa = True
     _supports_flex_attn = True

+    _warned_dropout_in_train_mode = False
+
+    def train(self, mode: bool = True):
+        # The MusicGen decoder applies dropout functionally (`nn.functional.dropout(..., training=self.training)`)
+        # from three float config attributes, so `nn.Dropout` sweeps do not reveal it. The released checkpoints
+        # were trained without dropout: with the historical config value of 0.1 the train-mode loss on the model's
+        # own tokens roughly doubles, and a fine-tune optimises a path that `generate` never uses. Say so once.
+        if mode and not self._warned_dropout_in_train_mode:
+            decoder_config = getattr(self.config, "decoder", self.config)
+            active = {
+                name: getattr(decoder_config, name, 0.0)
+                for name in ("dropout", "attention_dropout", "activation_dropout")
+                if getattr(decoder_config, name, 0.0)
+            }
+            if active:
+                logger.warning(
+                    "MusicGen entered train mode with non-zero decoder dropout %s. The pretrained MusicGen "
+                    "checkpoints were trained without dropout, so the train-mode forward pass will differ from the "
+                    "eval-mode pass used by `generate`. To fine-tune on the same path, set these to 0.0 in the "
+                    "decoder config before training.",
+                    active,
+                )
+            self._warned_dropout_in_train_mode = True
+        return super().train(mode)
+
     def _init_weights(self, module):
         std = self.config.initializer_factor
         if isinstance(module, nn.Linear):
